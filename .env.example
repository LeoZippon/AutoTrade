# Local secrets. Copy to .env, keep the file private, and never commit values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
TUSHARE_TOKEN=

# Hugging Face download credentials/mirror. `export NAME=value` is also accepted.
HF_TOKEN=
HF_ENDPOINT=https://huggingface.co

# Local Qwen gateway (vLLM FP8 TP=2 dual L20 behind the shared llm-gateway at
# /Data/lzp/llm-gateway) used by
# qwen3.8-27b-local: VLLM_API_KEY is the single Bearer key shared by the gateway
# and this client; the gateway refuses to start when it is empty.
VLLM_BASE_URL=http://127.0.0.1:8011/v1
VLLM_API_KEY=
